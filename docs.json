{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Proportion",
  "description": "Trader-financing protocol on HyperEVM.",
  "colors": {
    "primary": "#00D4FF",
    "light": "#00D4FF",
    "dark": "#00A3CC"
  },
  "favicon": "/logo/icon_black.png",
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#06080F"
    },
    "decoration": "gradient"
  },
  "fonts": {
    "heading": {
      "family": "Inter",
      "weight": 600
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "system"
  },
  "contextual": {
    "options": []
  },
  "navigation": {
    "languages": [
      {
        "language": "en",
        "default": true,
        "groups": [
          {
            "group": "Introduction",
            "pages": ["index", "offering"]
          },
          {
            "group": "Security",
            "pages": ["security"]
          },
          {
            "group": "Funded",
            "pages": [
              "funded/index",
              "funded/rules",
              "funded/payouts"
            ]
          },
          {
            "group": "Builders",
            "pages": [
              "builders/index",
              "builders/onboarding",
              "builders/rules",
              "builders/fees"
            ]
          },
          {
            "group": "Vault",
            "pages": ["vault/index", "vault/yield"]
          }
        ]
      },
      {
        "language": "ru",
        "groups": [
          {
            "group": "Введение",
            "pages": ["ru/index", "ru/offering"]
          },
          {
            "group": "Безопасность",
            "pages": ["ru/security"]
          },
          {
            "group": "Funded",
            "pages": [
              "ru/funded/index",
              "ru/funded/rules",
              "ru/funded/payouts"
            ]
          },
          {
            "group": "Билдеры",
            "pages": [
              "ru/builders/index",
              "ru/builders/onboarding",
              "ru/builders/rules",
              "ru/builders/fees"
            ]
          },
          {
            "group": "Vault",
            "pages": ["ru/vault/index", "ru/vault/yield"]
          }
        ]
      },
      {
        "language": "zh-Hans",
        "groups": [
          {
            "group": "介绍",
            "pages": ["zh/index", "zh/offering"]
          },
          {
            "group": "安全",
            "pages": ["zh/security"]
          },
          {
            "group": "Funded",
            "pages": [
              "zh/funded/index",
              "zh/funded/rules",
              "zh/funded/payouts"
            ]
          },
          {
            "group": "Builder",
            "pages": [
              "zh/builders/index",
              "zh/builders/onboarding",
              "zh/builders/rules",
              "zh/builders/fees"
            ]
          },
          {
            "group": "Vault",
            "pages": ["zh/vault/index", "zh/vault/yield"]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/logo2-light.svg",
    "dark": "/logo/logo2.svg",
    "href": "/"
  },
  "navbar": {
    "links": [
      {
        "label": "Security",
        "icon": "shield-check",
        "href": "/security"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open App",
      "href": "https://proportion.fi"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/proportion_fi",
      "telegram": "https://t.me/keysigner"
    }
  },
  "redirects": [
    { "source": "/traders", "destination": "/funded" },
    { "source": "/traders/rules", "destination": "/funded/rules" },
    { "source": "/traders/payouts", "destination": "/funded/payouts" },
    { "source": "/ru/traders", "destination": "/ru/funded" },
    { "source": "/ru/traders/rules", "destination": "/ru/funded/rules" },
    { "source": "/ru/traders/payouts", "destination": "/ru/funded/payouts" },
    { "source": "/zh/traders", "destination": "/zh/funded" },
    { "source": "/zh/traders/rules", "destination": "/zh/funded/rules" },
    { "source": "/zh/traders/payouts", "destination": "/zh/funded/payouts" }
  ]
}
